# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Get Supabase values from Supabase Dashboard > Project Settings > API.

# API port. Keep 5000 — the storefront proxy (client/vite.config.js) and the
# default VITE_API_URL both point at :5000. If you change this, update those too.
PORT=5000
NODE_ENV=development

# Supabase — the API's only data source. Without these the API returns 503.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=paste-anon-key-here
# service_role key: full DB access, server-side ONLY. Never put in frontend code.
# Used by: npm run create-admin (one-time admin account bootstrap).
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
# One-time password for the account created by npm run create-admin (min 6 chars).
# Only used if the account doesn't exist yet. Remove it from .env afterwards.
ADMIN_INITIAL_PASSWORD=

# Admin account for the Inventory dashboard. Server verifies this on every
# admin request. Main entry needs no extra password: log in as this email,
# open /inventory, press "Enter inventory dashboard".
ADMIN_EMAIL=admin2026@gmail.com

# Fallback entry: email + password form at /inventory. Set BOTH or the form
# cannot work (503/401). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Scripts and server-to-server calls: send X-Admin-Secret: <ADMIN_API_KEY>.
# Leave blank to disable this method entirely.
ADMIN_API_KEY=

# Comma-separated origins allowed to call the API. Dev default below matches
# the Vite dev server (port 3000). Leave blank = allow all (fine for local dev
# and single-service production where API + storefront share one origin).
CORS_ORIGINS=http://localhost:3000
