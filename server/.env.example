PORT=5000
NODE_ENV=development

# Supabase — the API's only data source. Without these the API returns 503.
# Project Settings -> Data API -> Project URL and anon public key
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key

# ---------- Admin access ----------
# The Inventory dashboard, /api/orders, and all product/promo writes are admin
# only. The server verifies this on every request — the React route guard is
# just a convenience and is not the security boundary.
#
# Two ways in, both checked server-side:
#
# 1. Supabase session token (used by the storefront admin dashboard).
#    Sign in with Supabase Auth, send:  Authorization: Bearer <access token>
#    The user must have the email below, or app_metadata.role = 'admin'.
#
# 2. X-Admin-Secret header, for server-to-server calls and scripts.
#    Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Leave it blank to disable this method entirely.
ADMIN_API_KEY=

# Password for POST /api/admin/session, which is how the dashboard signs in and
# gets the Bearer token. Set both this and ADMIN_SESSION_SECRET, or the
# dashboard cannot authenticate at all (it will 401).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=