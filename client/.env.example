# Homeline storefront — copy to `.env` and fill in the blanks.
# Get the Supabase values from: Supabase Dashboard -> Project Settings -> Data API
# (Project URL and anon public key). Vite only exposes VITE_ prefixed vars.

# Backend API base. Local dev default (Vite proxies /api to :5000):
VITE_API_URL=http://localhost:5000/api
# On production (single-service Render deploy serving both), leave as:
# VITE_API_URL=/api

# Required — without these, login/registration is disabled.
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — must match the server's ADMIN_EMAIL. Defaults to admin2026@gmail.com.
VITE_ADMIN_EMAIL=admin2026@gmail.com
